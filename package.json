{
  "name": "seeyou-workshops",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "SeeYou Workshops – Termin- und Buchungsverwaltung (iOS-App via Capacitor + Web-App)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  }
}
